@page "/login"
@model TurneroWorker.Pages.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Estética — Ingresar</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #db2777;
            --primary-hover: #be185d;
            --primary-light: #fdf2f8;
            --primary-border: #fbcfe8;
            --bg-body: #fff5f7;
            --card-bg: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --shadow-md: 0 4px 12px -2px rgb(219 39 119 / 0.15);
            --shadow-lg: 0 10px 25px -5px rgb(219 39 119 / 0.25);
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
        body {
            background-color: var(--bg-body);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .card {
            background: var(--card-bg);
            border-radius: 1.25rem;
            box-shadow: var(--shadow-lg);
            padding: 2.5rem 2rem;
            width: 100%;
            max-width: 380px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.5rem;
        }
        .logo {
            width: 64px;
            height: 64px;
            background: var(--primary-light);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid var(--primary-border);
        }
        .logo i { font-size: 1.75rem; color: var(--primary); }
        h1 { font-size: 1.3rem; font-weight: 700; color: var(--text-main); text-align: center; }
        p.subtitle { font-size: 0.85rem; color: var(--text-muted); text-align: center; margin-top: -0.75rem; }
        form { width: 100%; display: flex; flex-direction: column; gap: 1rem; }
        .field { display: flex; flex-direction: column; gap: 0.35rem; }
        label { font-size: 0.8rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
        input {
            border: 1.5px solid var(--primary-border);
            border-radius: 0.6rem;
            padding: 0.65rem 0.9rem;
            font-size: 1rem;
            color: var(--text-main);
            outline: none;
            transition: border-color 0.2s;
        }
        input:focus { border-color: var(--primary); }
        .error-box {
            background: #fef2f2;
            border: 1px solid #fca5a5;
            border-radius: 0.6rem;
            padding: 0.6rem 0.9rem;
            font-size: 0.85rem;
            color: #dc2626;
            width: 100%;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        button[type=submit] {
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 0.7rem;
            padding: 0.75rem;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }
        button[type=submit]:hover { background: var(--primary-hover); }
        button[type=submit]:active { transform: scale(0.98); }
    </style>
</head>
<body>
    <div class="card">
        <div class="logo"><i class="fa-solid fa-scissors"></i></div>
        <h1>Estética Turnos</h1>
        <p class="subtitle">Ingresá para acceder al sistema</p>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="error-box">
                <i class="fa-solid fa-circle-exclamation"></i>
                @Model.Error
            </div>
        }

        <form method="post">
            <div class="field">
                <label for="username">Usuario</label>
                <input id="username" name="Username" type="text" autocomplete="username" autofocus required placeholder="Usuario" />
            </div>
            <div class="field">
                <label for="password">Contraseña</label>
                <input id="password" name="Password" type="password" autocomplete="current-password" required placeholder="Contraseña" />
            </div>
            <button type="submit"><i class="fa-solid fa-right-to-bracket"></i> Ingresar</button>
        </form>
    </div>
</body>
</html>
